rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Get user document safely
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (hasUserDoc() ? getUserDoc().role : 'none');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tribeverve@gmail.com' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'management'
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & roles
    match /users/{userId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Students master collection
    match /students/{studentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();

      // Activities audit trail - Append only
      match /activities/{activityId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Top-level Activities audit log
    match /activities/{activityId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Properties & Inventory
    match /properties/{propertyId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Commissions & Payouts
    match /commissions/{commissionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /partnerPayouts/{payoutId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }
  }
}
