rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('intakeLookup', false) != true;
    }

    // Get user document safely
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // New claims take precedence. Legacy management meant administrator.
    function internalRole() {
      let current = request.auth.token.get('internalRole', '');
      let legacy = request.auth.token.get('leadOperationsRole', '');
      return current != '' ? current : legacy == 'management' ? 'admin'
        : legacy in ['sales', 'portfolio_owner'] ? 'management' : '';
    }

    // A revoked, pending, or deleted profile must lose access without waiting
    // for the next token refresh. Missing legacy approval fields stay compatible.
    function isActiveInternal() {
      return hasUserDoc()
        && getUserDoc().get('status', 'approved') == 'approved'
        && getUserDoc().get('isApproved', true) == true
        && getUserDoc().get('deletedAt', null) == null;
    }

    function isInternal() {
      return isSignedIn() && internalRole() in ['admin', 'management'] && isActiveInternal();
    }

    function isAdmin() {
      return isSignedIn() && internalRole() == 'admin' && isActiveInternal();
    }

    function isFinance() {
      return isActiveInternal() && getUserDoc().get('role', '') == 'finance' && internalRole() == 'finance';
    }

    function ownPartnerRecord(data) {
      return isActiveInternal() && getUserDoc().get('role', '') == 'partner'
        && getUserDoc().get('partnerId', '') != '' && data.partnerId == getUserDoc().partnerId;
    }

    function ownsPartner() {
      return isInternal()
        && resource.data.get('portfolioOwnerId', '') == request.auth.uid;
    }

    match /leadOperations/intake {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt is timestamp;
    }

    match /leadOwnerDirectory/{uid} {
      allow read: if isInternal();
    }

    match /portfolioOwnerDirectory/{uid} {
      allow read: if isInternal();
    }

    match /partnerAgreements/{partnerId} {
      allow get: if isInternal();
      allow create, update: if isInternal()
        && existsAfter(/databases/$(database)/documents/partners/$(partnerId))
        && request.resource.data.keys().hasOnly(['name', 'bytes'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() > 0
        && request.resource.data.bytes.size() <= 786432;
    }

    match /archivedStudents/{studentId} {
      allow read: if isInternal();
      allow create: if isInternal()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && !existsAfter(/databases/$(database)/documents/students/$(studentId))
        && request.resource.data.leadStatus == 'Inactive'
        && request.resource.data.archivalStatus == 'Archived'
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.studentId == get(/databases/$(database)/documents/students/$(studentId)).data.studentId
        && request.resource.data.archivalReason is string
        && request.resource.data.archivalReason.size() > 0
        && request.resource.data.archivalReason.size() <= 500;
    }

    // Profiles are client-created, but each authenticated user can only access
    // the profile whose document ID matches their Firebase Auth UID.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId)
        || (isInternal() && resource.data.role in ['partner','management','sales','portfolio_owner']);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'partner' && request.resource.data.get('partnerId', '') in ['', 'PART-U-' + request.auth.uid]);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId
        && resource.data.role == 'partner' && resource.data.get('partnerId', '') == ''
        && request.resource.data.partnerId == 'PART-U-' + request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','isApproved','status','deletedAt']))
        || (isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['role', 'isApproved', 'status', 'deletedAt', 'partnerId', 'roleMigrationVersion']));
      allow update: if isInternal() && request.auth.uid != userId
        && resource.data.role in ['partner','sales','portfolio_owner','management']
        && (resource.data.role != 'management' || resource.data.get('roleMigrationVersion', 0) == 1)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deletedAt','isApproved'])
        && request.resource.data.status == 'deleted' && request.resource.data.isApproved == false;
      allow delete: if isAdmin();
    }

    // A directory entry alone can be stale after an account is disabled.
    function eligibleOwner(uid, directory) {
      return uid is string && uid.size() > 0
        && (exists(/databases/$(database)/documents/leadOwnerDirectory/$(uid))
          || exists(/databases/$(database)/documents/portfolioOwnerDirectory/$(uid)))
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') in ['admin', 'management', 'sales', 'portfolio_owner']
        && get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'approved') == 'approved'
        && get(/databases/$(database)/documents/users/$(uid)).data.get('isApproved', true) == true
        && get(/databases/$(database)/documents/users/$(uid)).data.get('deletedAt', null) == null;
    }

    // Students master collection
    function canChangeSalesOwner() {
      let nextOwnerId = request.resource.data.get('salesOwnerId', '');
      let managesOwners = isInternal();
      return managesOwners && (nextOwnerId == ''
        || eligibleOwner(nextOwnerId, 'leadOwnerDirectory'));
    }

    function canChangeLeadOwner() {
      let id = request.resource.data.get('leadOwnerId', '');
      return isInternal() && request.resource.data.get('assignedSalesExecutiveId', '') == id
        && (id == '' || eligibleOwner(id, 'leadOwnerDirectory'));
    }

    match /students/{studentId} {
      allow read: if request.auth != null && request.auth.token.get('intakeLookup', false) == true;
      allow read: if isInternal() || isFinance() || ownPartnerRecord(resource.data);
      allow create: if (isInternal() || ownPartnerRecord(request.resource.data))
        && request.resource.data.get('archivalStatus', 'Active') != 'Archived'
        && request.resource.data.get('leadStatus', 'New') != 'Inactive'
        && request.resource.data.get('salesOwnerId', '') == ''
        && request.resource.data.get('leadOwnerId', '') == ''
        && request.resource.data.get('assignedSalesExecutiveId', '') == '';
      allow update: if (isInternal() || isFinance() || (ownPartnerRecord(resource.data) && ownPartnerRecord(request.resource.data) && request.resource.data.studentId == resource.data.studentId))
        && request.resource.data.get('archivalStatus', 'Active') != 'Archived'
        && request.resource.data.get('leadStatus', 'New') != 'Inactive'
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['salesOwnerId', 'salesOwnerName'])
          || canChangeSalesOwner())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['leadOwnerId', 'leadOwnerName', 'assignedSalesExecutiveId', 'assignedSalesExecutiveName'])
          || canChangeLeadOwner());
      allow delete: if isInternal()
        && !exists(/databases/$(database)/documents/archivedStudents/$(studentId))
        && existsAfter(/databases/$(database)/documents/archivedStudents/$(studentId));

      // Activities audit trail - Append only
      match /activities/{activityId} {
        allow read, create: if isInternal() || ownPartnerRecord(get(/databases/$(database)/documents/students/$(studentId)).data);
        allow update, delete: if false;
      }
    }

    // Top-level Activities audit log
    // Legacy events mix financial and operational details.
    match /activities/{activityId} {
      allow read: if isAdmin() || (isInternal() && resource.data.activityType == 'Internal Note Added');
      allow update, delete: if false;
      allow create: if (isInternal() || isFinance() || (request.resource.data.activityType in ['Lead Submitted', 'Lead Details Updated']
          && ownPartnerRecord(getAfter(/databases/$(database)/documents/students/$(request.resource.data.leadDocumentId)).data)
          && getAfter(/databases/$(database)/documents/students/$(request.resource.data.leadDocumentId)).data.studentId == request.resource.data.studentId))
        && request.resource.data.get('performedBy', {}).get('userId', '') == request.auth.uid;
    }

    // The management feed contains only fixed operational event metadata.
    match /operationalActivities/{activityId} {
      allow read: if isInternal();
      allow create: if isInternal()
        && request.resource.data.keys().hasOnly(['id', 'studentId', 'timestamp', 'performedBy', 'activityType'])
        && request.resource.data.keys().hasAll(['id', 'studentId', 'timestamp', 'performedBy', 'activityType'])
        && request.resource.data.id == activityId
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches('^(HA-[0-9]{4}-[0-9]{6}|PART-[0-9]{5})$')
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.matches('^[0-9]{2} [A-Za-z]{3} [0-9]{4}, [0-9]{2}:[0-9]{2}$')
        && request.resource.data.performedBy is map
        && request.resource.data.performedBy.keys().hasOnly(['userId', 'name', 'role'])
        && request.resource.data.performedBy.keys().hasAll(['userId', 'name', 'role'])
        && request.resource.data.performedBy.userId == request.auth.uid
        && ((exists(/databases/$(database)/documents/leadOwnerDirectory/$(request.auth.uid))
          && request.resource.data.performedBy.name == get(/databases/$(database)/documents/leadOwnerDirectory/$(request.auth.uid)).data.get('displayName', ''))
          || (exists(/databases/$(database)/documents/portfolioOwnerDirectory/$(request.auth.uid))
          && request.resource.data.performedBy.name == get(/databases/$(database)/documents/portfolioOwnerDirectory/$(request.auth.uid)).data.get('displayName', '')))
        && request.resource.data.performedBy.role == internalRole()
        && request.resource.data.activityType in [
          'Partner Portfolio Owner Reassigned', 'Partner Onboarded', 'Partner Updated',
          'Lead Owner Changed', 'Sales Owner Changed', 'Lead Submitted', 'Lead Details Updated',
          'Lead Archived', 'Pipeline Stage Change', 'Priority Change', 'Accommodation Status Change',
          'Booking Status Change', 'Move-in Status Change', 'Property Booking Recorded', 'Property Booking Updated'
        ];
      allow update, delete: if false;
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, create, update, delete: if isAdmin() || isFinance();
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read: if isInternal() || isFinance() || ownPartnerRecord(resource.data);
      allow create: if !request.resource.data.keys().hasAny(['leadTargets'])
        && (request.resource.data.get('portfolioOwnerId', '') == '' || eligibleOwner(request.resource.data.portfolioOwnerId, 'portfolioOwnerDirectory'))
        && (isInternal() || (isSignedIn() && request.resource.data.get('portfolioOwnerId', '') == ''
          && partnerId == 'PART-U-' + request.auth.uid && request.resource.data.partnerId == partnerId
          && request.resource.data.get('accountUid', '') == request.auth.uid));
      allow update: if (isInternal()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['portfolioOwnerId'])
          || request.resource.data.get('portfolioOwnerId', '') == ''
          || eligibleOwner(request.resource.data.portfolioOwnerId, 'portfolioOwnerDirectory')))
        || (ownsPartner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leadTargets']))
        || (ownPartnerRecord(resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leadTargets', 'portfolioOwnerId', 'accountUid', 'partnerId']));
      allow delete: if isInternal();
    }

    // Properties & Inventory
    match /properties/{propertyId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, create, update, delete: if isAdmin() || isFinance();
    }

    // Commissions & Payouts
    match /commissions/{commissionId} {
      allow read, create, update, delete: if isAdmin() || isFinance();
    }

    match /partnerPayouts/{payoutId} {
      allow read, create, update, delete: if isAdmin() || isFinance();
    }
  }
}
