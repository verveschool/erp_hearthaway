rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Get user document safely
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Profiles are client-created, but each authenticated user can only access
    // the profile whose document ID matches their Firebase Auth UID.
    match /users/{userId} {
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Students master collection
    match /students/{studentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();

      // Activities audit trail - Append only
      match /activities/{activityId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Top-level Activities audit log
    match /activities/{activityId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Properties & Inventory
    match /properties/{propertyId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Commissions & Payouts
    match /commissions/{commissionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /partnerPayouts/{payoutId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
