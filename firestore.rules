rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Get user document safely
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManagementEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'alisha@hearthaway.com' ||
        request.auth.token.email == 'tribeverve@gmail.com'
      );
    }

    function isManagement() {
      return isManagementEmail() ||
        (hasUserDoc() && getUserDoc().role in ['management', 'admin']);
    }

    function canCreateOwnPartnerRecord() {
      return hasUserDoc() && getUserDoc().role == 'partner' &&
        request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.partnerId == getUserDoc().partnerId &&
        request.resource.data.email == getUserDoc().email;
    }

    function canLinkOwnPartnerRecord() {
      return hasUserDoc() && getUserDoc().role == 'partner' &&
        resource.data.email == getUserDoc().email &&
        (!('accountUid' in resource.data) || resource.data.accountUid == request.auth.uid) &&
        request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.partnerId == resource.data.partnerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountUid']);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isManagement() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['portfolio_owner', 'partner']
      );
      allow update: if isManagement() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'role', 'isApproved', 'status', 'deletedAt'
        ])
      );
      allow delete: if isManagement();
    }

    // Students master collection
    match /students/{studentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();

      // Activities audit trail - Append only
      match /activities/{activityId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Top-level Activities audit log
    match /activities/{activityId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Partner records can be created or managed by management. A partner account
    // may create its own record or claim a matching pre-onboarded record once.
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow create: if isManagement() || canCreateOwnPartnerRecord();
      allow update: if isManagement() || canLinkOwnPartnerRecord();
      allow delete: if isManagement();
    }

    // Properties & Inventory
    match /properties/{propertyId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Commissions & Payouts
    match /commissions/{commissionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /partnerPayouts/{payoutId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
