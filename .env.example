# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# For an isolated Firebase cloud staging frontend only.
# Set NEXT_PUBLIC_FIREBASE_MODE=staging and supply a complete public Web app
# config for the staging project, including firestoreDatabaseId.
# NEXT_PUBLIC_FIREBASE_STAGING_CONFIG={"projectId":"your-staging-project","apiKey":"...","appId":"...","authDomain":"your-staging-project.firebaseapp.com","firestoreDatabaseId":"(default)"}

# Enable only after the operationalActivities Firestore rules have been deployed.
# NEXT_PUBLIC_OPERATIONAL_ACTIVITY_ENABLED=true
